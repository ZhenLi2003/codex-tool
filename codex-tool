#!/usr/bin/env bash
set -Eeuo pipefail
umask 022

TOOL_VERSION="1.8.0"
TOOL_HOME="${CODEX_TOOL_HOME:-$HOME/scripts/codex-tool}"
VERSIONS_DIR="$TOOL_HOME/versions"
DOWNLOADS_DIR="$TOOL_HOME/downloads"
CURRENT_LINK="$TOOL_HOME/current"
LOCAL_BIN="${CODEX_TOOL_BIN_DIR:-$HOME/.local/bin}"
CODEX_COMMAND="$LOCAL_BIN/codex"
TOOL_COMMAND="$LOCAL_BIN/codex-tool"
CODEX_DATA_DIR="${CODEX_HOME:-$HOME/.codex}"
REPO="openai/codex"
API_BASE="https://api.github.com/repos/$REPO"
TARGET="x86_64-unknown-linux-musl"
PACKAGE_ASSET="codex-package-${TARGET}.tar.gz"
CHECKSUM_ASSET="codex-package_SHA256SUMS"
HISTORY_KEEP="${CODEX_TOOL_HISTORY_KEEP:-2}"
API_TIMEOUT="${CODEX_TOOL_API_TIMEOUT:-120}"
CONNECT_TIMEOUT="${CODEX_TOOL_CONNECT_TIMEOUT:-30}"
DOWNLOAD_RETRIES="${CODEX_TOOL_DOWNLOAD_RETRIES:-8}"
DOWNLOAD_RETRY_DELAY="${CODEX_TOOL_DOWNLOAD_RETRY_DELAY:-5}"
DOWNLOAD_STALL_TIME="${CODEX_TOOL_DOWNLOAD_STALL_TIME:-180}"
DOWNLOAD_MAX_TIME="${CODEX_TOOL_DOWNLOAD_MAX_TIME:-0}"
LOCK_TIMEOUT="${CODEX_TOOL_LOCK_TIMEOUT:-10}"
CONFIG_DIR="${CODEX_TOOL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/codex-tool}"
GITHUB_TOKEN_FILE="${CODEX_TOOL_GITHUB_TOKEN_FILE:-$CONFIG_DIR/github-token}"
GITHUB_TOKEN_URL="https://github.com/settings/personal-access-tokens/new?name=codex-tool&description=GitHub+API+access+for+codex-tool&expires_in=90&contents=read"
SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
WORK_DIR=""
CURL_TLS_ARGS=()
DAEMON_SUPPORTED=0
DAEMON_STATE="unsupported"
DAEMON_BIN=""
DAEMON_BACKEND=""
DAEMON_WAS_RUNNING=0
DAEMON_LAST_JSON=""
DAEMON_LAST_ERR=""
MANAGER_LOCK_DIR=""
MANAGER_PID_FILE=""

log()  { printf '==> %s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

cleanup() {
  if [[ -n "$WORK_DIR" && -d "$WORK_DIR" ]]; then
    rm -rf -- "$WORK_DIR"
  fi
  if [[ -n "$MANAGER_PID_FILE" && -f "$MANAGER_PID_FILE" ]]; then
    local holder=""
    IFS= read -r holder < "$MANAGER_PID_FILE" || true
    [[ "$holder" != "$" ]] || rm -f -- "$MANAGER_PID_FILE"
  fi
  if [[ -e "/proc/$/fd/9" ]]; then
    flock -u 9 2>/dev/null || true
    exec 9>&-
  fi
}
trap cleanup EXIT

usage() {
  cat <<'USAGE'
Usage:
  codex-tool install X.Y.Z          Install/repair and activate a stable version
  codex-tool update                 Install/activate the latest stable version
  codex-tool delete X.Y.Z           Delete an installed non-current version
  codex-tool clean [--all] [--dry-run] [--yes]
                                    Delete persisted Codex sessions through the official
                                    app-server API. Default: inactive threads only.
                                    --all also interrupts/deletes background threads.
  codex-tool prune [--dry-run] [--yes] [--force]
                                    Delete all loaded/background threads, stop the daemon,
                                    remove Codex program/runtime assets, and preserve
                                    inactive session history plus user config/auth.
  codex-tool list                   Show current and locally installed versions only
  codex-tool switch X.Y.Z           Safely activate an installed version with daemon
                                    stop/restore when a managed daemon is running
  codex-tool daemon status          Inspect managed app-server daemon state
  codex-tool daemon repair [--yes]  Repair stale managed daemon runtime state
  codex-tool auth login             Save and verify a GitHub access token
  codex-tool auth status            Show which GitHub authentication source is active
  codex-tool auth logout            Remove the token saved by codex-tool
  codex-tool version                Show codex-tool version
  codex-tool help

Environment:
  GITHUB_TOKEN                      Optional GitHub token for higher API rate limits
  CODEX_TOOL_HISTORY_KEEP=N         Historical versions retained (default: 2)
  CODEX_TOOL_HOME=PATH              Manager directory (default: ~/scripts/codex-tool)
  CODEX_TOOL_BIN_DIR=PATH           Command-link directory (default: ~/.local/bin)
  CODEX_HOME=PATH                   Codex data directory (default: ~/.codex)
  CODEX_TOOL_GITHUB_TOKEN_FILE=PATH  Saved GitHub token file
  CODEX_TOOL_API_TIMEOUT=N          GitHub API max time in seconds (default: 120)
  CODEX_TOOL_CONNECT_TIMEOUT=N      Connection timeout in seconds (default: 30)
  CODEX_TOOL_DOWNLOAD_RETRIES=N     Retries after first large download attempt (default: 8)
  CODEX_TOOL_DOWNLOAD_RETRY_DELAY=N Delay between large download attempts (default: 5)
  CODEX_TOOL_DOWNLOAD_STALL_TIME=N  Abort/resume if transfer stays below 1 B/s for N sec
                                    (default: 180; 0 disables low-speed detection)
  CODEX_TOOL_DOWNLOAD_MAX_TIME=N    Per-attempt large download max time (default: 0=no limit)
  CODEX_TOOL_LOCK_TIMEOUT=N          Manager lock wait in seconds (default: 10)

GitHub API authentication / rate-limit fallback:
  API requests use GITHUB_TOKEN when set, otherwise a token previously saved by
  codex-tool. If an anonymous request is rate-limited, codex-tool first tries the
  existing no-proxy fallback. If that cannot reach GitHub and the session is
  interactive, it can guide you through creating a token, verify it through the
  normal network path, and save it with mode 0600. Asset downloads continue to
  honor the normal proxy configuration.
USAGE
}

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

init_curl_compat() {
  # --proto is retained as a security requirement (available since curl 7.20.2).
  curl --proto '=https' --version >/dev/null 2>&1 \
    || die "curl is too old: codex-tool requires support for --proto (curl >= 7.20.2)"

  CURL_TLS_ARGS=()
  if curl --tlsv1.2 --version >/dev/null 2>&1; then
    CURL_TLS_ARGS+=( --tlsv1.2 )
  else
    warn "this curl does not support --tlsv1.2 (added in curl 7.34.0); continuing without the explicit TLS-minimum option."
  fi
}

validate_uint() {
  local name="$1" value="$2"
  [[ "$value" =~ ^[0-9]+$ ]] || die "$name must be a non-negative integer"
}

validate_version() {
  local version="$1"
  [[ "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] \
    || die "invalid stable version '$version'; expected X.Y.Z without rust-v or prerelease suffix"
}

ensure_supported_platform() {
  [[ "$(uname -s)" == "Linux" ]] || die "this build supports Linux only"
  case "$(uname -m)" in
    x86_64|amd64) ;;
    *) die "unsupported CPU architecture: $(uname -m); expected x86_64" ;;
  esac
}

ensure_layout() { mkdir -p -- "$TOOL_HOME" "$VERSIONS_DIR" "$DOWNLOADS_DIR" "$LOCAL_BIN"; }

lock_manager() {
  need_cmd flock
  need_cmd stat
  validate_uint CODEX_TOOL_LOCK_TIMEOUT "$LOCK_TIMEOUT"

  local lock_root=""
  if [[ -n "${XDG_RUNTIME_DIR:-}" && -d "$XDG_RUNTIME_DIR" && ! -L "$XDG_RUNTIME_DIR" ]]; then
    local runtime_owner
    runtime_owner="$(stat -c '%u' "$XDG_RUNTIME_DIR" 2>/dev/null || true)"
    if [[ "$runtime_owner" == "$UID" ]]; then
      lock_root="$XDG_RUNTIME_DIR/codex-tool"
    fi
  fi
  [[ -n "$lock_root" ]] || lock_root="/tmp/codex-tool-$UID"

  if [[ -e "$lock_root" || -L "$lock_root" ]]; then
    [[ -d "$lock_root" && ! -L "$lock_root" ]] \
      || die "manager lock path is not a normal directory: $lock_root"
  else
    ( umask 077; mkdir -- "$lock_root" ) \
      || die "unable to create manager lock directory: $lock_root"
  fi

  local owner mode
  owner="$(stat -c '%u' "$lock_root" 2>/dev/null || true)"
  [[ "$owner" == "$UID" ]] \
    || die "manager lock directory is not owned by the current user: $lock_root"
  chmod 0700 -- "$lock_root" \
    || die "unable to secure manager lock directory: $lock_root"
  mode="$(stat -c '%a' "$lock_root" 2>/dev/null || true)"
  [[ "$mode" == "700" ]] \
    || die "manager lock directory must have mode 0700: $lock_root (mode=$mode)"

  MANAGER_LOCK_DIR="$lock_root"
  MANAGER_PID_FILE="$lock_root/manager.pid"
  exec 9>"$lock_root/manager.lock"

  if ! flock -w "$LOCK_TIMEOUT" -x 9; then
    local holder=""
    if [[ -f "$MANAGER_PID_FILE" ]]; then
      IFS= read -r holder < "$MANAGER_PID_FILE" || true
    fi
    if [[ "$holder" =~ ^[0-9]+$ && -r "/proc/$holder/cmdline" ]]; then
      local holder_cmd
      holder_cmd="$(tr '\0' ' ' < "/proc/$holder/cmdline" 2>/dev/null || true)"
      die "unable to acquire codex-tool manager lock within ${LOCK_TIMEOUT}s; holder PID $holder: ${holder_cmd:-unknown command}"
    fi
    die "unable to acquire codex-tool manager lock within ${LOCK_TIMEOUT}s; another codex-tool mutation may still be running"
  fi

  ( umask 077; printf '%s\n' "$" > "$MANAGER_PID_FILE" )
}

make_work_dir() {
  [[ -z "$WORK_DIR" ]] || return 0
  WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/codex-tool.XXXXXXXX")"
}

# Print a short, safe diagnostic from a GitHub JSON error body.
github_error_message() {
  local body="$1"
  python3 - "$body" <<'PY' 2>/dev/null || true
import json, sys
try:
    with open(sys.argv[1], 'r', encoding='utf-8') as f:
        obj = json.load(f)
    msg = obj.get('message')
    if isinstance(msg, str):
        print(msg.replace('\n', ' ')[:500])
except Exception:
    pass
PY
}

header_value() {
  local headers="$1" name="$2"
  awk -v wanted="${name,,}" '
    BEGIN { IGNORECASE=1 }
    {
      line=$0; sub(/\r$/, "", line)
      split(line, a, ":")
      key=tolower(a[1])
      if (key == wanted) {
        sub(/^[^:]*:[[:space:]]*/, "", line)
        value=line
      }
    }
    END { if (value != "") print value }
  ' "$headers"
}

is_rate_limit_response() {
  local status="$1" headers="$2" body="$3"
  [[ "$status" == "403" ]] || return 1
  local remaining msg
  remaining="$(header_value "$headers" "x-ratelimit-remaining")"
  [[ "$remaining" == "0" ]] && return 0
  msg="$(github_error_message "$body")"
  [[ "${msg,,}" == *"rate limit"* ]]
}

effective_github_token() {
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    printf '%s\n' "$GITHUB_TOKEN"
    return 0
  fi
  if [[ -f "$GITHUB_TOKEN_FILE" ]]; then
    local token=""
    IFS= read -r token < "$GITHUB_TOKEN_FILE" || true
    [[ -n "$token" ]] && printf '%s\n' "$token"
  fi
}

github_token_source() {
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    printf 'environment GITHUB_TOKEN\n'
  elif [[ -s "$GITHUB_TOKEN_FILE" ]]; then
    printf 'saved token (%s)\n' "$GITHUB_TOKEN_FILE"
  else
    printf 'none\n'
  fi
}

validate_github_token_text() {
  local token="$1"
  [[ -n "$token" ]] || return 1
  [[ ! "$token" =~ [[:space:]] ]]
}

save_github_token() {
  local token="$1" dir tmp
  validate_github_token_text "$token" || die "refusing to save an empty token or token containing whitespace"
  dir="$(dirname "$GITHUB_TOKEN_FILE")"
  mkdir -p -- "$dir"
  chmod 0700 -- "$dir" 2>/dev/null || true
  tmp="$GITHUB_TOKEN_FILE.tmp.$$"
  ( umask 077; printf '%s\n' "$token" > "$tmp" )
  chmod 0600 -- "$tmp"
  mv -f -- "$tmp" "$GITHUB_TOKEN_FILE"
  log "saved GitHub token to $GITHUB_TOKEN_FILE (mode 0600)" >&2
}

print_github_token_help() {
  cat >&2 <<EOF
GitHub authentication can avoid the anonymous 60-requests/hour/IP API limit.

Create a personal access token here:
  $GITHUB_TOKEN_URL

For this public openai/codex release lookup, codex-tool does not need repository
write access. GitHub recommends fine-grained personal access tokens. The release
API needs only read access to repository contents; the link above pre-fills
Contents: read and a 90-day expiration. Reduce the lifetime further if desired.

The token is used only for GitHub API authentication. Release asset downloads
continue to use your normal network/proxy settings.
EOF
}

write_curl_auth_config() {
  local token="$1" dest="$2"
  validate_github_token_text "$token" || return 1
  ( umask 077; printf 'header = "Authorization: Bearer %s"\n' "$token" > "$dest" )
}

prompt_github_token_and_retry() {
  local url="$1" output="$2" label="$3"
  [[ -t 0 && -t 2 ]] || return 2

  printf '\n' >&2
  print_github_token_help
  printf '\nPaste GitHub token (input hidden; empty input cancels): ' >&2
  local token=""
  IFS= read -r -s token
  printf '\n' >&2
  [[ -n "$token" ]] || { warn "GitHub token entry cancelled."; return 1; }
  validate_github_token_text "$token" || { warn "token contains whitespace and was rejected."; return 1; }

  local body="$WORK_DIR/api-token.$$.json"
  local headers="$WORK_DIR/api-token.$$.headers"
  local err="$WORK_DIR/api-token.$$.stderr"
  local result rc status msg
  result="$(github_api_once "$url" "$body" "$headers" "$err" normal "$token")"
  rc="$(sed -n '1p' <<<"$result")"
  status="$(sed -n '2p' <<<"$result")"

  if [[ "$rc" == "0" && "$status" =~ ^2[0-9][0-9]$ ]]; then
    save_github_token "$token"
    mv -f -- "$body" "$output"
    warn "authenticated GitHub API request succeeded; the saved token will be used for future API requests."
    return 0
  fi

  msg="$(github_error_message "$body")"
  warn "the supplied GitHub token could not access $label (curl exit $rc, HTTP $status); it was not saved."
  [[ -n "$msg" ]] && warn "GitHub: $msg"
  if [[ -s "$err" ]]; then
    warn "curl: $(tr '\n' ' ' < "$err" | sed 's/[[:space:]]\+/ /g' | cut -c1-500)"
  fi
  return 1
}

github_api_once() {
  local url="$1" body="$2" headers="$3" stderr_file="$4" mode="$5"
  local token="${6:-}"
  local -a args=(
    --proto '=https'
    "${CURL_TLS_ARGS[@]}"
    --silent
    --show-error
    --location
    --connect-timeout "$CONNECT_TIMEOUT"
    --max-time "$API_TIMEOUT"
    --retry 0
    -D "$headers"
    -o "$body"
    -w '%{http_code}'
    -H 'Accept: application/vnd.github+json'
    -H 'X-GitHub-Api-Version: 2022-11-28'
    -H 'User-Agent: codex-tool'
  )

  if [[ -n "$token" ]]; then
    local auth_config="$WORK_DIR/curl-auth.$$.cfg"
    write_curl_auth_config "$token" "$auth_config" || {
      printf '2\n000\n'
      return 0
    }
    args+=( --config "$auth_config" )
  fi
  if [[ "$mode" == "direct" ]]; then
    # Explicitly override proxy env vars and any proxy configured by ~/.curlrc.
    args+=( --proxy '' --noproxy '*' )
  fi

  local status rc
  set +e
  status="$(curl "${args[@]}" "$url" 2>"$stderr_file")"
  rc=$?
  set -e
  printf '%s\n%s\n' "$rc" "${status:-000}"
}

# Fetch one GitHub REST API JSON document. Normal requests use GITHUB_TOKEN when
# provided, otherwise the token saved by codex-tool. Only an anonymous primary
# rate-limit response triggers the no-proxy fallback and interactive token rescue.
github_api_get() {
  local url="$1" output="$2" label="${3:-GitHub API request}"
  make_work_dir
  local normal_body="$WORK_DIR/api-normal.$$.json"
  local normal_headers="$WORK_DIR/api-normal.$$.headers"
  local normal_err="$WORK_DIR/api-normal.$$.stderr"
  local token token_source result rc status msg remaining reset
  token="$(effective_github_token)"
  token_source="$(github_token_source)"

  result="$(github_api_once "$url" "$normal_body" "$normal_headers" "$normal_err" normal "$token")"
  rc="$(sed -n '1p' <<<"$result")"
  status="$(sed -n '2p' <<<"$result")"

  if [[ "$rc" == "0" && "$status" =~ ^2[0-9][0-9]$ ]]; then
    mv -f -- "$normal_body" "$output"
    return 0
  fi

  if [[ "$rc" == "0" ]] && is_rate_limit_response "$status" "$normal_headers" "$normal_body"; then
    remaining="$(header_value "$normal_headers" "x-ratelimit-remaining")"
    reset="$(header_value "$normal_headers" "x-ratelimit-reset")"
    msg="$(github_error_message "$normal_body")"
    warn "$label was rejected by GitHub API rate limiting (HTTP $status${remaining:+, remaining=$remaining})."
    [[ -n "$msg" ]] && warn "GitHub: $msg"
    if [[ "$reset" =~ ^[0-9]+$ ]]; then
      local reset_text
      reset_text="$(date -d "@$reset" '+%Y-%m-%d %H:%M:%S %z' 2>/dev/null || true)"
      [[ -n "$reset_text" ]] && warn "rate-limit reset reported by GitHub: $reset_text"
    fi

    if [[ -n "$token" ]]; then
      warn "this request was already authenticated using $token_source; changing proxy paths will not restore that token's GitHub API quota."
      return 1
    fi

    warn "retrying this GitHub API request once with proxy use disabled; asset downloads will keep the normal proxy configuration."

    local direct_body="$WORK_DIR/api-direct.$$.json"
    local direct_headers="$WORK_DIR/api-direct.$$.headers"
    local direct_err="$WORK_DIR/api-direct.$$.stderr"
    result="$(github_api_once "$url" "$direct_body" "$direct_headers" "$direct_err" direct "")"
    rc="$(sed -n '1p' <<<"$result")"
    status="$(sed -n '2p' <<<"$result")"

    if [[ "$rc" == "0" && "$status" =~ ^2[0-9][0-9]$ ]]; then
      warn "direct GitHub API retry succeeded; continuing without changing your proxy environment."
      mv -f -- "$direct_body" "$output"
      return 0
    fi

    warn "direct GitHub API retry also failed (curl exit $rc, HTTP $status)."
    msg="$(github_error_message "$direct_body")"
    [[ -n "$msg" ]] && warn "GitHub direct retry: $msg"
    if [[ -s "$direct_err" ]]; then
      warn "curl direct retry: $(tr '\n' ' ' < "$direct_err" | sed 's/[[:space:]]\+/ /g' | cut -c1-500)"
    fi

    if prompt_github_token_and_retry "$url" "$output" "$label"; then
      return 0
    fi

    if [[ ! -t 0 || ! -t 2 ]]; then
      warn "interactive token setup is unavailable in this session."
      print_github_token_help
      warn "after creating a token, either export GITHUB_TOKEN or run 'codex-tool auth login' in an interactive shell."
    fi
    return 1
  fi

  msg="$(github_error_message "$normal_body")"
  warn "$label failed (curl exit $rc, HTTP $status; auth source: $token_source)."
  [[ -n "$msg" ]] && warn "GitHub: $msg"
  if [[ -s "$normal_err" ]]; then
    warn "curl: $(tr '\n' ' ' < "$normal_err" | sed 's/[[:space:]]\+/ /g' | cut -c1-500)"
  fi
  return 1
}

version_codex_path() {
  local version="$1"
  local dir="$VERSIONS_DIR/$version"
  if [[ -x "$dir/bin/codex" ]]; then
    printf '%s\n' "$dir/bin/codex"
  elif [[ -x "$dir/codex" ]]; then
    printf '%s\n' "$dir/codex"
  else
    return 1
  fi
}

version_layout() {
  local version="$1"
  local dir="$VERSIONS_DIR/$version"
  if [[ -f "$dir/codex-package.json" && -x "$dir/bin/codex" && -x "$dir/bin/codex-code-mode-host" && -x "$dir/codex-path/rg" ]]; then
    printf 'package\n'
  elif [[ -x "$dir/codex" ]]; then
    printf 'legacy-single-binary\n'
  else
    printf 'incomplete\n'
  fi
}

is_complete_package_dir() {
  local dir="$1"
  [[ -f "$dir/codex-package.json" ]] &&
  [[ -x "$dir/bin/codex" ]] &&
  [[ -x "$dir/bin/codex-code-mode-host" ]] &&
  [[ -x "$dir/codex-path/rg" ]]
}

current_version() {
  if [[ -L "$CURRENT_LINK" ]]; then
    local target version
    target="$(readlink "$CURRENT_LINK")"
    version="${target##*/}"
    if [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && version_codex_path "$version" >/dev/null 2>&1; then
      printf '%s\n' "$version"
      return 0
    fi
  fi
  return 1
}

managed_link_or_absent() {
  local link_path="$1" expected_target="$2" label="$3"
  if [[ ! -e "$link_path" && ! -L "$link_path" ]]; then return 0; fi
  if [[ -L "$link_path" ]]; then
    local raw actual expected
    raw="$(readlink "$link_path" 2>/dev/null || true)"
    actual="$(readlink -f "$link_path" 2>/dev/null || true)"
    expected="$(readlink -f "$expected_target" 2>/dev/null || true)"
    if [[ -n "$actual" && -n "$expected" && "$actual" == "$expected" ]]; then return 0; fi
    # Broken links into codex-tool/current are considered manager-owned, useful after HOME migration.
    if [[ "$label" == "codex command" && "$raw" == *"/scripts/codex-tool/current/"* ]]; then return 0; fi
    if [[ "$label" == "codex-tool command" && "$raw" == *"/scripts/codex-tool/codex-tool" ]]; then return 0; fi
  fi
  die "$label already exists and is not managed by codex-tool: $link_path"
}

ensure_command_links() {
  managed_link_or_absent "$TOOL_COMMAND" "$SELF_PATH" "codex-tool command"
  ln -sfn -- "$SELF_PATH" "$TOOL_COMMAND"

  local cv codex_path
  cv="$(current_version 2>/dev/null || true)"
  if [[ -n "$cv" ]]; then
    codex_path="$(version_codex_path "$cv")"
    local relative
    if [[ "$codex_path" == */bin/codex ]]; then relative="$CURRENT_LINK/bin/codex"; else relative="$CURRENT_LINK/codex"; fi
    managed_link_or_absent "$CODEX_COMMAND" "$relative" "codex command"
    ln -sfn -- "$relative" "$CODEX_COMMAND"
  fi
}


daemon_supports_lifecycle() {
  local binary="$1"
  [[ -x "$binary" ]] || return 1
  "$binary" app-server daemon --help >/dev/null 2>&1 9>&-
}

daemon_find_control_binary() {
  local cv candidate
  cv="$(current_version 2>/dev/null || true)"
  if [[ -n "$cv" ]]; then
    candidate="$(version_codex_path "$cv" 2>/dev/null || true)"
    if [[ -n "$candidate" ]] && daemon_supports_lifecycle "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi

  for candidate in \
    "$CODEX_COMMAND" \
    "$CODEX_DATA_DIR/packages/app-server-daemon/current/bin/codex" \
    "$CODEX_DATA_DIR/packages/standalone/current/bin/codex"
  do
    if daemon_supports_lifecycle "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

daemon_json_field() {
  local file="$1" field="$2"
  [[ -s "$file" ]] || return 0
  python3 - "$file" "$field" <<'PY' 2>/dev/null || true
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        value=json.load(f).get(sys.argv[2])
    if value is not None:
        print(value if not isinstance(value, bool) else str(value).lower())
except Exception:
    pass
PY
}

daemon_pid_records_present() {
  local state="$CODEX_DATA_DIR/app-server-daemon" name
  for name in app-server.pid app-server-updater.pid daemon.pid daemon-updater.pid; do
    [[ -e "$state/$name" || -L "$state/$name" ]] && return 0
  done
  return 1
}

daemon_managed_pids() {
  local proc pid uid exe cmd owned
  for proc in /proc/[0-9]*; do
    [[ -r "$proc/status" && -r "$proc/cmdline" ]] || continue
    pid="${proc##*/}"
    uid="$(awk '/^Uid:/{print $2; exit}' "$proc/status" 2>/dev/null || true)"
    [[ "$uid" == "$UID" ]] || continue
    exe="$(readlink "$proc/exe" 2>/dev/null || true)"
    exe="${exe% (deleted)}"
    cmd="$(tr '\0' ' ' < "$proc/cmdline" 2>/dev/null || true)"
    [[ "$cmd" == *"app-server"* ]] || continue

    owned=0
    case "$exe" in
      "$CODEX_DATA_DIR/packages/"*|"$VERSIONS_DIR/"*) owned=1 ;;
    esac
    [[ "$cmd" == *"app-server daemon pid-update-loop"* ]] && owned=1
    [[ "$cmd" == *"$CODEX_DATA_DIR/app-server-control/"* ]] && owned=1
    (( owned )) && printf '%s\n' "$pid"
  done
}

daemon_has_processes() {
  [[ -n "$(daemon_managed_pids | head -n1)" ]]
}

daemon_snapshot() {
  DAEMON_SUPPORTED=0
  DAEMON_STATE="unsupported"
  DAEMON_BIN=""
  DAEMON_BACKEND=""
  DAEMON_WAS_RUNNING=0
  DAEMON_LAST_JSON=""
  DAEMON_LAST_ERR=""

  local binary
  binary="$(daemon_find_control_binary 2>/dev/null || true)"
  if [[ -z "$binary" ]]; then
    if daemon_has_processes || daemon_pid_records_present || [[ -e "$CODEX_DATA_DIR/app-server-control" ]]; then
      DAEMON_STATE="unknown"
    fi
    return 0
  fi

  DAEMON_SUPPORTED=1
  DAEMON_BIN="$binary"
  make_work_dir
  DAEMON_LAST_JSON="$WORK_DIR/daemon-version.$$.json"
  DAEMON_LAST_ERR="$WORK_DIR/daemon-version.$$.stderr"

  local rc status
  set +e
  "$binary" app-server daemon version >"$DAEMON_LAST_JSON" 2>"$DAEMON_LAST_ERR" 9>&-
  rc=$?
  set -e

  if (( rc == 0 )); then
    status="$(daemon_json_field "$DAEMON_LAST_JSON" status)"
    DAEMON_BACKEND="$(daemon_json_field "$DAEMON_LAST_JSON" backend)"
    case "$status" in
      running|alreadyRunning|started|restarted)
        if [[ -n "$DAEMON_BACKEND" ]]; then
          DAEMON_STATE="running"
          DAEMON_WAS_RUNNING=1
        else
          DAEMON_STATE="unmanaged-running"
        fi
        ;;
      stopped|notRunning)
        DAEMON_STATE="stopped"
        ;;
      *)
        DAEMON_STATE="unknown"
        ;;
    esac
    return 0
  fi

  if daemon_has_processes || daemon_pid_records_present || \
     [[ -e "$CODEX_DATA_DIR/app-server-control/app-server-control.sock" || -L "$CODEX_DATA_DIR/app-server-control/app-server-control.sock" ]]; then
    DAEMON_STATE="stale"
    DAEMON_WAS_RUNNING=1
  else
    DAEMON_STATE="unknown"
  fi
}

daemon_lifecycle() {
  local binary="$1" action="$2" output="$3" err="$4"
  local rc
  set +e
  # Never let a long-lived Codex daemon inherit codex-tool's manager lock FD.
  "$binary" app-server daemon "$action" >"$output" 2>"$err" 9>&-
  rc=$?
  set -e
  return "$rc"
}

daemon_stop_for_mutation() {
  daemon_snapshot
  case "$DAEMON_STATE" in
    unsupported|stopped)
      return 0
      ;;
    unmanaged-running)
      warn "an unmanaged Codex app-server is running; refusing to mutate Codex state automatically."
      warn "stop that app-server manually, then rerun the codex-tool command."
      return 1
      ;;
    stale|unknown)
      warn "Codex app-server daemon state is $DAEMON_STATE; refusing to mutate Codex state."
      [[ ! -s "$DAEMON_LAST_ERR" ]] || warn "daemon: $(tr '\n' ' ' < "$DAEMON_LAST_ERR" | sed 's/[[:space:]]\+/ /g' | cut -c1-500)"
      warn "run 'codex-tool daemon repair' and retry."
      return 1
      ;;
    running)
      make_work_dir
      local out="$WORK_DIR/daemon-stop.$$.json" err="$WORK_DIR/daemon-stop.$$.stderr"
      log "stopping managed Codex app-server daemon before mutation"
      if ! daemon_lifecycle "$DAEMON_BIN" stop "$out" "$err"; then
        warn "unable to stop managed Codex app-server daemon safely."
        [[ ! -s "$err" ]] || warn "daemon stop: $(tr '\n' ' ' < "$err" | sed 's/[[:space:]]\+/ /g' | cut -c1-500)"
        warn "no Codex mutation was performed; run 'codex-tool daemon repair'."
        return 1
      fi
      local status
      status="$(daemon_json_field "$out" status)"
      case "$status" in
        stopped|notRunning)
          DAEMON_STATE="stopped"
          return 0
          ;;
        *)
          warn "daemon stop returned unexpected status: ${status:-unknown}"
          return 1
          ;;
      esac
      ;;
  esac
}

daemon_restore_after_mutation() {
  (( DAEMON_WAS_RUNNING )) || return 0
  local binary
  binary="$(daemon_find_control_binary 2>/dev/null || true)"
  if [[ -z "$binary" ]]; then
    warn "Codex CLI mutation succeeded, but no daemon-capable Codex binary is available to restore app-server."
    warn "use Codex with --no-daemon or run 'codex-tool daemon repair' after installing a daemon-capable version."
    return 1
  fi

  make_work_dir
  local out="$WORK_DIR/daemon-start.$$.json" err="$WORK_DIR/daemon-start.$$.stderr"
  log "restoring managed Codex app-server daemon"
  if ! daemon_lifecycle "$binary" start "$out" "$err"; then
    warn "Codex CLI mutation succeeded, but app-server daemon restoration failed."
    [[ ! -s "$err" ]] || warn "daemon start: $(tr '\n' ' ' < "$err" | sed 's/[[:space:]]\+/ /g' | cut -c1-500)"
    warn "the selected CLI remains active; use 'codex --no-daemon' or run 'codex-tool daemon repair'."
    return 1
  fi

  local status
  status="$(daemon_json_field "$out" status)"
  case "$status" in
    started|alreadyRunning|running|restarted)
      log "managed Codex app-server daemon restored"
      return 0
      ;;
    *)
      warn "daemon start returned unexpected status: ${status:-unknown}"
      return 1
      ;;
  esac
}

switch_version_raw() {
  local version="$1"
  validate_version "$version"
  version_codex_path "$version" >/dev/null || die "version $version is not installed"
  local layout
  layout="$(version_layout "$version")"
  if [[ "$layout" != "package" ]]; then
    warn "Codex $version uses $layout layout; modern features such as code-mode host may be unavailable. Re-run 'codex-tool install $version' to repair it."
  fi
  local tmp_link="$TOOL_HOME/.current.$$.tmp"
  rm -f -- "$tmp_link"
  ln -s -- "versions/$version" "$tmp_link"
  mv -Tf -- "$tmp_link" "$CURRENT_LINK"
  ensure_command_links
  log "active Codex version: $version"
}

switch_version() {
  local version="$1"
  validate_version "$version"
  version_codex_path "$version" >/dev/null || die "version $version is not installed"

  daemon_stop_for_mutation || return 1
  if ! switch_version_raw "$version"; then
    warn "version activation failed; attempting to restore the previous daemon state."
    daemon_restore_after_mutation || true
    return 1
  fi
  daemon_restore_after_mutation
}

version_running_pids() {
  local version="$1" target proc pid uid exe
  target="$(readlink -f "$VERSIONS_DIR/$version" 2>/dev/null || true)"
  [[ -n "$target" ]] || return 0
  for proc in /proc/[0-9]*; do
    [[ -r "$proc/status" ]] || continue
    pid="${proc##*/}"
    uid="$(awk '/^Uid:/{print $2; exit}' "$proc/status" 2>/dev/null || true)"
    [[ "$uid" == "$UID" ]] || continue
    exe="$(readlink "$proc/exe" 2>/dev/null || true)"
    exe="${exe% (deleted)}"
    case "$exe" in
      "$target"/*) printf '%s\n' "$pid" ;;
    esac
  done
}

parse_latest_version() {
  local json_file="$1"
  python3 - "$json_file" <<'PY'
import json, re, sys
with open(sys.argv[1], encoding='utf-8') as f: r=json.load(f)
tag=r.get('tag_name','')
m=re.fullmatch(r'rust-v((?:0|[1-9]\d*)\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*))', tag)
if not m or r.get('draft') or r.get('prerelease'):
    raise SystemExit(f"unexpected latest release metadata: tag={tag!r}")
print(m.group(1))
PY
}

parse_release_assets() {
  local json_file="$1" expected_version="$2"
  python3 - "$json_file" "$expected_version" "$PACKAGE_ASSET" "$CHECKSUM_ASSET" <<'PY'
import json,re,sys
path,version,pkg_name,sum_name=sys.argv[1:]
with open(path,encoding='utf-8') as f:r=json.load(f)
if r.get('tag_name') != f'rust-v{version}': raise SystemExit('release tag mismatch')
if r.get('draft') or r.get('prerelease'): raise SystemExit('refusing draft/prerelease')
assets={a.get('name'):a for a in r.get('assets',[]) if isinstance(a,dict)}
def one(name):
    a=assets.get(name)
    if not a: raise SystemExit(f'release asset not found: {name}')
    url=a.get('browser_download_url',''); dig=a.get('digest','')
    if not url.startswith('https://github.com/openai/codex/releases/download/'):
        raise SystemExit(f'unexpected asset URL for {name}: {url!r}')
    if not re.fullmatch(r'sha256:[0-9a-fA-F]{64}',dig):
        raise SystemExit(f'{name} has no valid GitHub SHA-256 digest')
    return url,dig.split(':',1)[1].lower()
for name in (pkg_name,sum_name):
    url,dig=one(name); print(url); print(dig)
PY
}

small_download() {
  local url="$1" dest="$2" label="${3:-download}"
  local attempt=0 max_attempts=$((DOWNLOAD_RETRIES + 1))
  local err="$WORK_DIR/small-download.$$.stderr" rc

  # Keep retry behavior independent of curl --retry-all-errors, which is only
  # available in curl 7.71.0 and newer. Older enterprise distributions can
  # therefore still retry checksum/metadata asset downloads.
  while (( attempt < max_attempts )); do
    attempt=$((attempt + 1))
    rm -f -- "$dest" "$err"

    set +e
    curl --proto '=https' "${CURL_TLS_ARGS[@]}" --fail --silent --show-error --location \
      --connect-timeout "$CONNECT_TIMEOUT" --max-time "$API_TIMEOUT" \
      --retry 0 \
      -H 'User-Agent: codex-tool' "$url" -o "$dest" 2>"$err"
    rc=$?
    set -e

    if (( rc == 0 )); then
      rm -f -- "$err"
      return 0
    fi

    rm -f -- "$dest"
    warn "$label download failed (curl exit $rc, attempt $attempt/$max_attempts)."
    if [[ -s "$err" ]]; then
      warn "curl: $(tr '\n' ' ' < "$err" | sed 's/[[:space:]]\+/ /g' | cut -c1-500)"
    fi
    (( attempt < max_attempts )) || break
    sleep "$DOWNLOAD_RETRY_DELAY"
  done

  return 1
}

human_size() {
  python3 - "$1" <<'PY'
import sys
n=int(sys.argv[1]); units=['B','KiB','MiB','GiB']; i=0
while n>=1024 and i<len(units)-1: n/=1024; i+=1
print(f'{n:.1f} {units[i]}')
PY
}

resumable_download() {
  local url="$1" dest="$2" label="$3"
  mkdir -p -- "$(dirname "$dest")"
  local attempt=0 max_attempts=$((DOWNLOAD_RETRIES + 1)) range_restart_done=0
  while (( attempt < max_attempts )); do
    attempt=$((attempt + 1))
    local have=0
    [[ -f "$dest" ]] && have="$(stat -c '%s' "$dest" 2>/dev/null || echo 0)"
    if (( have > 0 )); then
      log "resuming $label from $(human_size "$have") (attempt $attempt/$max_attempts)"
    else
      log "downloading $label (attempt $attempt/$max_attempts)"
    fi

    local -a args=(
      --proto '=https' "${CURL_TLS_ARGS[@]}" --fail --show-error --location
      --connect-timeout "$CONNECT_TIMEOUT" --max-time "$DOWNLOAD_MAX_TIME"
      --retry 0 --continue-at - -H 'User-Agent: codex-tool'
      -o "$dest"
    )
    if (( DOWNLOAD_STALL_TIME > 0 )); then
      args+=( --speed-limit 1 --speed-time "$DOWNLOAD_STALL_TIME" )
    fi

    local err="$WORK_DIR/download.$$.stderr" rc
    set +e
    curl "${args[@]}" "$url" 2> >(tee "$err" >&2)
    rc=$?
    set -e
    if (( rc == 0 )); then return 0; fi

    local now=0
    [[ -f "$dest" ]] && now="$(stat -c '%s' "$dest" 2>/dev/null || echo 0)"
    warn "$label transfer interrupted (curl exit $rc); preserved $(human_size "$now") for resume."

    # curl 33 is CURLE_RANGE_ERROR. Some servers answer a resumed request without range support.
    if (( have > 0 && rc == 33 && range_restart_done == 0 )); then
      warn "server rejected byte-range resume; restarting this file once from byte 0."
      rm -f -- "$dest"
      range_restart_done=1
      continue
    fi

    (( attempt < max_attempts )) || break
    sleep "$DOWNLOAD_RETRY_DELAY"
  done
  return 1
}

verify_sha256() {
  local file="$1" expected="$2" label="$3" actual
  actual="$(sha256sum "$file" | awk '{print tolower($1)}')"
  [[ "$actual" == "$expected" ]] || die "$label SHA-256 mismatch (expected $expected, got $actual)"
}

checksum_entry() {
  local manifest="$1" asset="$2"
  awk -v asset="$asset" '$2 == asset && length($1)==64 && $1 !~ /[^0-9A-Fa-f]/ {print tolower($1); found=1; exit} END{if(!found) exit 1}' "$manifest"
}

validate_tar_safety() {
  local archive="$1"
  python3 - "$archive" <<'PY'
import posixpath,sys,tarfile
p=sys.argv[1]
with tarfile.open(p,'r:gz') as t:
    members=t.getmembers()
    if not members: raise SystemExit('archive is empty')
    for m in members:
        n=m.name
        norm=posixpath.normpath(n)
        if n.startswith('/') or norm == '..' or norm.startswith('../'):
            raise SystemExit(f'unsafe archive path: {n!r}')
        if m.ischr() or m.isblk() or m.isfifo():
            raise SystemExit(f'unsupported special file in archive: {n!r}')
        if m.issym() or m.islnk():
            target=m.linkname
            if target.startswith('/'):
                raise SystemExit(f'unsafe absolute link target: {target!r}')
            base=posixpath.dirname(norm)
            resolved=posixpath.normpath(posixpath.join(base,target))
            if resolved == '..' or resolved.startswith('../'):
                raise SystemExit(f'unsafe link target: {target!r}')
PY
}

verify_binary_version() {
  local binary="$1" expected="$2"
  make_work_dir
  local iso="$WORK_DIR/verify-home"
  mkdir -p "$iso/home" "$iso/codex" "$iso/config" "$iso/cache" "$iso/data" "$iso/state"
  local output rc
  set +e
  output="$(HOME="$iso/home" CODEX_HOME="$iso/codex" XDG_CONFIG_HOME="$iso/config" XDG_CACHE_HOME="$iso/cache" XDG_DATA_HOME="$iso/data" XDG_STATE_HOME="$iso/state" "$binary" --version 2>&1)"
  rc=$?
  set -e
  (( rc == 0 )) || die "downloaded Codex failed version check: $output"
  python3 - "$expected" "$output" <<'PY'
import re,sys
expected,output=sys.argv[1:]
versions=re.findall(r'(?<![0-9])([0-9]+\.[0-9]+\.[0-9]+)(?![0-9])',output)
if expected not in versions: raise SystemExit(f'binary version mismatch: expected {expected}, output={output!r}')
PY
}

install_version() {
  local version="$1"
  validate_version "$version"
  local existing_layout
  existing_layout="$(version_layout "$version")"
  if [[ "$existing_layout" == "package" ]]; then
    log "Codex $version is already installed as a complete package"
    if switch_version "$version"; then
      prune_history
      return 0
    fi
    return 1
  elif [[ "$existing_layout" != "incomplete" ]]; then
    warn "Codex $version is present in $existing_layout layout; reinstalling from GitHub to repair modern runtime components."
  elif [[ -e "$VERSIONS_DIR/$version" ]]; then
    warn "Codex $version installation is incomplete; reinstalling it."
  fi

  if [[ -d "$VERSIONS_DIR/$version" ]]; then
    local running_pids
    running_pids="$(version_running_pids "$version")"
    [[ -z "$running_pids" ]] || die "cannot replace Codex $version while running process(es) still use it: $(tr '\n' ' ' <<<"$running_pids" | sed 's/[[:space:]]\+/ /g')"
  fi

  make_work_dir
  local release_json="$WORK_DIR/release.json"
  log "resolving GitHub release rust-v$version"
  github_api_get "$API_BASE/releases/tags/rust-v$version" "$release_json" "Codex release rust-v$version" \
    || die "unable to fetch release rust-v$version"

  local parsed pkg_url pkg_api_sha sums_url sums_api_sha
  parsed="$(parse_release_assets "$release_json" "$version")" || die "release metadata validation failed for $version"
  pkg_url="$(sed -n '1p' <<<"$parsed")"
  pkg_api_sha="$(sed -n '2p' <<<"$parsed")"
  sums_url="$(sed -n '3p' <<<"$parsed")"
  sums_api_sha="$(sed -n '4p' <<<"$parsed")"

  local cache_dir="$DOWNLOADS_DIR/rust-v$version"
  local archive="$cache_dir/$PACKAGE_ASSET.part"
  local sums="$WORK_DIR/$CHECKSUM_ASSET"

  log "downloading checksum manifest"
  small_download "$sums_url" "$sums" "$CHECKSUM_ASSET" || die "unable to download $CHECKSUM_ASSET"
  verify_sha256 "$sums" "$sums_api_sha" "$CHECKSUM_ASSET"
  local manifest_sha
  manifest_sha="$(checksum_entry "$sums" "$PACKAGE_ASSET")" || die "unable to find $PACKAGE_ASSET in $CHECKSUM_ASSET"
  [[ "$manifest_sha" == "$pkg_api_sha" ]] || die "GitHub package digest and checksum manifest disagree"

  resumable_download "$pkg_url" "$archive" "$PACKAGE_ASSET" || die "download failed after all retry attempts; partial file retained at $archive"
  local actual_sha
  actual_sha="$(sha256sum "$archive" | awk '{print tolower($1)}')"
  if [[ "$actual_sha" != "$pkg_api_sha" ]]; then
    warn "downloaded package SHA-256 mismatch; removing corrupted partial file so the next run starts cleanly."
    rm -f -- "$archive"
    die "package SHA-256 mismatch (expected $pkg_api_sha, got $actual_sha)"
  fi
  log "SHA-256 verified: $actual_sha"

  validate_tar_safety "$archive" || die "package archive safety validation failed"
  local stage="$VERSIONS_DIR/.$version.new.$$"
  rm -rf -- "$stage"
  mkdir -p -- "$stage"
  tar -xzf "$archive" -C "$stage" --no-same-owner --no-same-permissions

  is_complete_package_dir "$stage" || { rm -rf -- "$stage"; die "downloaded Codex package is missing required runtime files"; }
  chmod 0755 "$stage/bin/codex" "$stage/bin/codex-code-mode-host" "$stage/codex-path/rg"
  [[ ! -f "$stage/codex-resources/bwrap" ]] || chmod 0755 "$stage/codex-resources/bwrap"
  [[ ! -f "$stage/bin/codex-responses-api-proxy" ]] || chmod 0755 "$stage/bin/codex-responses-api-proxy"
  ln -sfn "bin/codex" "$stage/codex"
  verify_binary_version "$stage/bin/codex" "$version"

  cat > "$stage/codex-tool-manifest" <<MANIFEST
codex-tool-version=$TOOL_VERSION
version=$version
tag=rust-v$version
target=$TARGET
asset=$PACKAGE_ASSET
sha256=$actual_sha
installed_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
MANIFEST

  # Do not stop the daemon during network transfer/verification. Enter the
  # lifecycle transaction only when files and the active selection will change.
  if ! daemon_stop_for_mutation; then
    rm -rf -- "$stage"
    return 1
  fi

  if ! rm -rf -- "$VERSIONS_DIR/$version"; then
    daemon_restore_after_mutation || true
    rm -rf -- "$stage"
    return 1
  fi
  if ! mv -- "$stage" "$VERSIONS_DIR/$version"; then
    daemon_restore_after_mutation || true
    return 1
  fi
  log "installed Codex $version"

  if ! switch_version_raw "$version"; then
    warn "Codex package was installed but could not be activated; attempting to restore daemon state."
    daemon_restore_after_mutation || true
    return 1
  fi

  rm -rf -- "$cache_dir"
  if ! daemon_restore_after_mutation; then
    warn "Codex $version remains active. Previous versions were retained because daemon restoration failed."
    return 1
  fi

  prune_history
}

latest_stable_version() {
  make_work_dir
  local json="$WORK_DIR/latest.json"
  log "checking the latest stable GitHub release" >&2
  github_api_get "$API_BASE/releases/latest" "$json" "latest Codex release" \
    || die "unable to query the latest stable release"
  parse_latest_version "$json" || die "unable to parse latest stable release version"
}

prune_history() {
  validate_uint CODEX_TOOL_HISTORY_KEEP "$HISTORY_KEEP"
  local current
  current="$(current_version 2>/dev/null || true)"
  mapfile -t all < <(find "$VERSIONS_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -Vr || true)
  local kept=0 v
  for v in "${all[@]}"; do
    [[ "$v" == "$current" ]] && continue
    if (( kept < HISTORY_KEEP )); then
      kept=$((kept+1))
    else
      local running_pids
      running_pids="$(version_running_pids "$v")"
      if [[ -n "$running_pids" ]]; then
        warn "keeping old Codex version $v because running process(es) still use it: $(tr '\n' ' ' <<<"$running_pids" | sed 's/[[:space:]]\+/ /g')"
        continue
      fi
      log "removing old Codex version: $v"
      rm -rf -- "$VERSIONS_DIR/$v"
    fi
  done
}

list_versions() {
  local current
  current="$(current_version 2>/dev/null || true)"
  if [[ -n "$current" ]]; then printf 'Current: %s\n\n' "$current"; else printf 'Current: (none)\n\n'; fi
  printf 'Installed locally:\n'
  local found=0 v layout marker
  while IFS= read -r v; do
    [[ -n "$v" ]] || continue
    found=1; layout="$(version_layout "$v")"; marker=" "
    [[ "$v" == "$current" ]] && marker="*"
    if [[ "$v" == "$current" ]]; then
      printf '  %s %s [current, %s]\n' "$marker" "$v" "$layout"
    else
      printf '  %s %s [%s]\n' "$marker" "$v" "$layout"
    fi
  done < <(find "$VERSIONS_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -Vr || true)
  (( found )) || printf '  (none)\n'
  printf '\nNote: list is local-only and never queries GitHub.\n'
}

delete_version() {
  local version="$1"; validate_version "$version"
  [[ -d "$VERSIONS_DIR/$version" ]] || die "version $version is not installed"
  local current="$(current_version 2>/dev/null || true)"
  [[ "$version" != "$current" ]] || die "cannot delete the active version $version; switch first"
  local running_pids
  running_pids="$(version_running_pids "$version")"
  [[ -z "$running_pids" ]] || die "cannot delete Codex $version; running process(es) still use it: $(tr '\n' ' ' <<<"$running_pids" | sed 's/[[:space:]]\+/ /g')"
  rm -rf -- "$VERSIONS_DIR/$version" "$DOWNLOADS_DIR/rust-v$version"
  log "deleted Codex $version"
}

confirm_or_die() {
  local yes="$1" prompt="$2"
  [[ "$yes" == "1" ]] && return 0
  [[ -t 0 ]] || die "confirmation required; re-run with --yes"
  printf '%s [y/N] ' "$prompt"
  local ans; read -r ans
  [[ "$ans" =~ ^[Yy]([Ee][Ss])?$ ]] || die "cancelled"
}

session_admin_binary() {
  local candidate managed cv
  if [[ -n "$DAEMON_LAST_JSON" && -s "$DAEMON_LAST_JSON" ]]; then
    managed="$(daemon_json_field "$DAEMON_LAST_JSON" managedCodexPath)"
    if [[ -n "$managed" && -x "$managed" ]]; then
      printf '%s\n' "$managed"
      return 0
    fi
  fi

  cv="$(current_version 2>/dev/null || true)"
  if [[ -n "$cv" ]]; then
    candidate="$(version_codex_path "$cv" 2>/dev/null || true)"
    if [[ -n "$candidate" && -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi

  for candidate in \
    "$CODEX_COMMAND" \
    "$CODEX_DATA_DIR/packages/app-server-daemon/current/bin/codex" \
    "$CODEX_DATA_DIR/packages/standalone/current/bin/codex"
  do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

write_session_admin_script() {
  make_work_dir
  local script="$WORK_DIR/session-admin.py"
  [[ -f "$script" ]] && { printf '%s\n' "$script"; return 0; }

  cat > "$script" <<'PY'
import argparse
import json
import os
import select
import subprocess
import sys
import threading
import time

class RpcError(RuntimeError):
    def __init__(self, method, error):
        self.method = method
        self.error = error if isinstance(error, dict) else {"message": str(error)}
        super().__init__(f"{method}: {self.error.get('message', self.error)}")

class Client:
    def __init__(self, codex, transport, socket_path=None):
        if transport == "uds":
            if not socket_path:
                raise RuntimeError("missing daemon socket path")
            args = [codex, "stdio-to-uds", socket_path]
        else:
            args = [codex, "app-server", "--listen", "stdio://"]

        self.stderr_lines = []
        self.proc = subprocess.Popen(
            args,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            bufsize=1,
            close_fds=True,
            env=os.environ.copy(),
        )
        if self.proc.stdin is None or self.proc.stdout is None:
            raise RuntimeError("failed to open Codex app-server pipes")

        def drain_stderr():
            if self.proc.stderr is None:
                return
            for line in self.proc.stderr:
                self.stderr_lines.append(line.rstrip())
                if len(self.stderr_lines) > 100:
                    del self.stderr_lines[:20]

        self.stderr_thread = threading.Thread(target=drain_stderr, daemon=True)
        self.stderr_thread.start()
        self.next_id = 1
        self.request("initialize", {
            "clientInfo": {
                "name": "codex-tool",
                "title": "codex-tool session manager",
                "version": "1.8.0",
            },
            "capabilities": {"experimentalApi": True},
        }, timeout=15)
        self.notify("initialized", None)

    def close(self):
        proc = self.proc
        try:
            if proc.stdin:
                proc.stdin.close()
        except Exception:
            pass
        if proc.poll() is None:
            try:
                proc.terminate()
                proc.wait(timeout=2)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass

    def _write(self, msg):
        if self.proc.stdin is None:
            raise RuntimeError("app-server stdin is closed")
        self.proc.stdin.write(json.dumps(msg, separators=(",", ":")) + "\n")
        self.proc.stdin.flush()

    def notify(self, method, params=None):
        msg = {"method": method}
        if params is not None:
            msg["params"] = params
        self._write(msg)

    def request(self, method, params=None, timeout=20):
        rid = self.next_id
        self.next_id += 1
        msg = {"id": rid, "method": method}
        if params is not None:
            msg["params"] = params
        self._write(msg)

        deadline = time.monotonic() + timeout
        fd = self.proc.stdout.fileno()
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise RuntimeError(f"timed out waiting for {method}")
            ready, _, _ = select.select([fd], [], [], remaining)
            if not ready:
                raise RuntimeError(f"timed out waiting for {method}")
            line = self.proc.stdout.readline()
            if line == "":
                stderr = " | ".join(self.stderr_lines[-10:])
                raise RuntimeError(
                    f"Codex app-server closed while waiting for {method}"
                    + (f": {stderr}" if stderr else "")
                )
            try:
                reply = json.loads(line)
            except json.JSONDecodeError:
                continue
            if reply.get("id") != rid:
                continue
            if "error" in reply:
                raise RpcError(method, reply["error"])
            return reply.get("result") or {}

def status_type(thread):
    status = thread.get("status")
    if isinstance(status, dict):
        return str(status.get("type") or "unknown")
    if isinstance(status, str):
        return status
    return "unknown"

def list_threads(client):
    result = []
    seen = set()
    for archived in (False, True):
        cursor = None
        while True:
            params = {"archived": archived, "limit": 100}
            if cursor:
                params["cursor"] = cursor
            page = client.request("thread/list", params)
            for thread in page.get("data") or []:
                tid = thread.get("id")
                if tid and tid not in seen:
                    seen.add(tid)
                    result.append(thread)
            cursor = page.get("nextCursor")
            if not cursor:
                break
    return result

def list_loaded_ids(client):
    result = []
    seen = set()
    cursor = None
    while True:
        params = {"limit": 100}
        if cursor:
            params["cursor"] = cursor
        page = client.request("thread/loaded/list", params)
        for item in page.get("data") or []:
            tid = item if isinstance(item, str) else item.get("id")
            if tid and tid not in seen:
                seen.add(tid)
                result.append(tid)
        cursor = page.get("nextCursor")
        if not cursor:
            break
    return result

def read_status(client, thread_id):
    result = client.request(
        "thread/read",
        {"threadId": thread_id, "includeTurns": False},
        timeout=15,
    )
    thread = result.get("thread") or {}
    return status_type(thread)

def in_progress_turn(client, thread_id):
    page = client.request(
        "thread/turns/list",
        {"threadId": thread_id, "limit": 20, "sortDirection": "desc"},
        timeout=15,
    )
    for turn in page.get("data") or []:
        if turn.get("status") == "inProgress":
            return turn.get("id")
    return None

def interrupt_thread(client, thread_id):
    last_error = None
    for _ in range(3):
        try:
            turn_id = in_progress_turn(client, thread_id)
        except Exception as exc:
            last_error = exc
            turn_id = None
        if not turn_id:
            try:
                return read_status(client, thread_id) != "active"
            except Exception:
                return False
        try:
            client.request(
                "turn/interrupt",
                {"threadId": thread_id, "turnId": turn_id},
                timeout=15,
            )
        except RpcError as exc:
            last_error = exc
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            time.sleep(0.35)
            try:
                if read_status(client, thread_id) != "active":
                    return True
            except Exception as exc:
                last_error = exc
        time.sleep(0.25)
    if last_error:
        print(f"warning: unable to interrupt thread {thread_id}: {last_error}", file=sys.stderr)
    return False

def delete_many(client, ids):
    pending = list(dict.fromkeys(ids))
    deleted = []
    errors = {}
    for _pass in range(5):
        if not pending:
            break
        next_pending = []
        progress = False
        for tid in pending:
            try:
                client.request("thread/delete", {"threadId": tid}, timeout=20)
                deleted.append(tid)
                errors.pop(tid, None)
                progress = True
            except Exception as exc:
                errors[tid] = str(exc)
                next_pending.append(tid)
        pending = next_pending
        if not pending:
            break
        if not progress:
            time.sleep(0.75)
        else:
            time.sleep(0.25)
    return deleted, pending, errors

def write_ids(path, ids):
    if not path:
        return
    with open(path, "w", encoding="utf-8") as f:
        for tid in ids:
            f.write(tid + "\n")

def read_ids(path):
    if not path or not os.path.exists(path):
        return []
    with open(path, encoding="utf-8") as f:
        return [line.strip() for line in f if line.strip()]

def print_clean_scan(threads, include_active):
    active = [t for t in threads if status_type(t) == "active"]
    inactive = [t for t in threads if status_type(t) != "active"]
    print(f"Persisted threads: {len(threads)}")
    print(f"Inactive/deletable candidates: {len(inactive)}")
    print(f"Active/background threads: {len(active)}")
    print(f"Would delete: {len(threads) if include_active else len(inactive)}")
    if active and not include_active:
        print(f"Would preserve active/background: {len(active)}")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--codex", required=True)
    parser.add_argument("--transport", choices=("uds", "stdio"), required=True)
    parser.add_argument("--socket")
    parser.add_argument(
        "--mode",
        choices=("scan-clean", "clean", "scan-prune", "prepare-prune", "delete-ids"),
        required=True,
    )
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--ids-file")
    args = parser.parse_args()

    client = Client(args.codex, args.transport, args.socket)
    try:
        if args.mode in ("scan-clean", "clean"):
            threads = list_threads(client)
            print_clean_scan(threads, args.all)
            if args.mode == "scan-clean":
                return 0

            targets = list(threads) if args.all else [
                t for t in threads if status_type(t) != "active"
            ]

            if args.all:
                active = [t for t in targets if status_type(t) == "active"]
                failed_interrupts = []
                for thread in active:
                    tid = thread["id"]
                    print(f"==> interrupting active thread {tid}")
                    if not interrupt_thread(client, tid):
                        failed_interrupts.append(tid)
                if failed_interrupts:
                    print(
                        "error: active thread(s) could not be interrupted: "
                        + " ".join(failed_interrupts),
                        file=sys.stderr,
                    )
                    return 2

            ids = [t["id"] for t in targets if t.get("id")]
            deleted, pending, errors = delete_many(client, ids)
            print(f"Deleted threads: {len(deleted)}")
            if pending:
                print(f"Could not delete: {len(pending)}", file=sys.stderr)
                for tid in pending:
                    print(f"warning: {tid}: {errors.get(tid, 'unknown error')}", file=sys.stderr)
                return 3
            return 0

        if args.mode in ("scan-prune", "prepare-prune"):
            threads = {t.get("id"): t for t in list_threads(client) if t.get("id")}
            loaded = list_loaded_ids(client)
            active = [
                tid for tid in loaded
                if status_type(threads.get(tid, {})) == "active"
            ]
            print(f"Loaded/background threads: {len(loaded)}")
            print(f"Active background threads: {len(active)}")

            if args.mode == "scan-prune":
                return 0

            write_ids(args.ids_file, loaded)
            failed = []
            for tid in active:
                print(f"==> interrupting background thread {tid}")
                if not interrupt_thread(client, tid):
                    failed.append(tid)
            if failed:
                print(
                    "error: background thread(s) could not be interrupted: "
                    + " ".join(failed),
                    file=sys.stderr,
                )
                return 4
            return 0

        if args.mode == "delete-ids":
            ids = read_ids(args.ids_file)
            if not ids:
                print("Background thread records to delete: 0")
                return 0
            deleted, pending, errors = delete_many(client, ids)
            print(f"Deleted background thread records: {len(deleted)}")
            if pending:
                print(f"Could not delete background thread records: {len(pending)}", file=sys.stderr)
                for tid in pending:
                    print(f"warning: {tid}: {errors.get(tid, 'unknown error')}", file=sys.stderr)
                return 5
            return 0

        return 2
    finally:
        client.close()

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
    except Exception as exc:
        print(f"error: Codex app-server session management failed: {exc}", file=sys.stderr)
        raise SystemExit(1)
PY
  chmod 0600 "$script"
  printf '%s\n' "$script"
}

session_admin_run() {
  local mode="$1"
  local all_threads="${2:-0}"
  local ids_file="${3:-}"
  local force_transport="${4:-auto}"

  daemon_snapshot
  local transport socket_path binary script
  socket_path=""

  if [[ "$force_transport" == "stdio" ]]; then
    transport="stdio"
  else
    case "$DAEMON_STATE" in
      running|unmanaged-running)
        socket_path="$(daemon_json_field "$DAEMON_LAST_JSON" socketPath)"
        [[ -n "$socket_path" ]] || {
          warn "running app-server did not report a control socket"
          return 1
        }
        transport="uds"
        ;;
      stopped|unsupported)
        transport="stdio"
        ;;
      stale|unknown)
        warn "Codex app-server daemon state is $DAEMON_STATE; session cleanup is unsafe."
        warn "run 'codex-tool daemon repair' first."
        return 1
        ;;
      *)
        warn "unsupported daemon state: $DAEMON_STATE"
        return 1
        ;;
    esac
  fi

  binary="$(session_admin_binary 2>/dev/null || true)"
  [[ -n "$binary" ]] || {
    warn "no Codex binary is available for app-server session management"
    return 1
  }

  script="$(write_session_admin_script)"
  local -a args=(
    "$script"
    --codex "$binary"
    --transport "$transport"
    --mode "$mode"
  )
  [[ "$all_threads" == "1" ]] && args+=( --all )
  [[ -z "$ids_file" ]] || args+=( --ids-file "$ids_file" )
  [[ "$transport" != "uds" ]] || args+=( --socket "$socket_path" )

  # The Python process and every Codex child it starts must not inherit FD 9.
  python3 "${args[@]}" 9>&-
}

foreground_codex_pids() {
  local proc pid uid exe cmd
  for proc in /proc/[0-9]*; do
    [[ -r "$proc/status" && -r "$proc/cmdline" ]] || continue
    pid="${proc##*/}"
    uid="$(awk '/^Uid:/{print $2; exit}' "$proc/status" 2>/dev/null || true)"
    [[ "$uid" == "$UID" ]] || continue
    exe="$(readlink "$proc/exe" 2>/dev/null || true)"
    exe="${exe% (deleted)}"
    case "$exe" in
      "$VERSIONS_DIR/"*|"$CODEX_DATA_DIR/packages/"*) ;;
      *) continue ;;
    esac
    cmd="$(tr '\0' ' ' < "$proc/cmdline" 2>/dev/null || true)"
    [[ "$cmd" == *"app-server"* ]] && continue
    printf '%s %s\n' "$pid" "$cmd"
  done
}

daemon_stop_for_prune() {
  daemon_snapshot
  case "$DAEMON_STATE" in
    running)
      make_work_dir
      local out="$WORK_DIR/prune-daemon-stop.$$.json"
      local err="$WORK_DIR/prune-daemon-stop.$$.stderr"
      log "stopping managed Codex app-server daemon"
      if ! daemon_lifecycle "$DAEMON_BIN" stop "$out" "$err"; then
        [[ ! -s "$err" ]] || warn "daemon stop: $(tr '\n' ' ' < "$err" | sed 's/[[:space:]]\+/ /g' | cut -c1-500)"
        return 1
      fi
      ;;
    stopped|unsupported)
      ;;
    unmanaged-running)
      warn "an unmanaged Codex app-server is running; prune will not terminate it automatically."
      warn "stop it manually and rerun prune."
      return 1
      ;;
    stale|unknown)
      warn "daemon state is $DAEMON_STATE; attempting conservative managed-process cleanup for prune."
      ;;
  esac

  daemon_terminate_managed_processes || return 1
  daemon_cleanup_transient_state || return 1
  return 0
}

clean_data() {
  local yes="$1" all_threads="$2" dry_run="$3"

  log "scanning persisted Codex sessions through app-server"
  session_admin_run scan-clean "$all_threads" "" auto || return 1
  (( dry_run )) && {
    log "dry run only; no session data was modified"
    return 0
  }

  if (( all_threads )); then
    confirm_or_die "$yes" "Delete all persisted Codex sessions? Active/background threads will be interrupted first."
  else
    confirm_or_die "$yes" "Delete inactive persisted Codex sessions? Active/background threads will be preserved."
  fi

  session_admin_run clean "$all_threads" "" auto
}

prune_all() {
  local yes="$1" force="$2" dry_run="$3"

  if [[ -e "$CODEX_COMMAND" && ! -L "$CODEX_COMMAND" ]]; then
    if [[ -f "$CODEX_COMMAND" ]]; then
      (( force )) || die "$CODEX_COMMAND is a regular file, not a symlink; use 'prune --force' only if it should be removed"
    else
      die "$CODEX_COMMAND is not a symlink or regular file; refusing to remove it"
    fi
  fi

  local foreground
  foreground="$(foreground_codex_pids)"
  if [[ -n "$foreground" ]]; then
    warn "foreground Codex process(es) are still using managed program files:"
    printf '%s\n' "$foreground" >&2
    die "close those Codex sessions before prune"
  fi

  log "scanning loaded/background Codex threads"
  session_admin_run scan-prune 0 "" auto || return 1

  if (( dry_run )); then
    printf 'Program/runtime assets that would be removed:\n'
    printf '  %s\n' "$VERSIONS_DIR" "$CURRENT_LINK" "$DOWNLOADS_DIR" "$CODEX_COMMAND"
    printf '  %s\n' "$CODEX_DATA_DIR/packages/app-server-daemon" "$CODEX_DATA_DIR/packages/standalone"
    printf '  %s\n' "$CODEX_DATA_DIR/app-server-daemon" "$CODEX_DATA_DIR/app-server-control"
    log "dry run only; no threads, daemon state, or program files were modified"
    return 0
  fi

  confirm_or_die "$yes" "Delete all loaded/background Codex threads, stop the daemon, and remove Codex program/runtime assets? Inactive saved history and user config/auth will be preserved."

  make_work_dir
  local ids_file="$WORK_DIR/prune-background-threads.txt"
  : > "$ids_file"

  session_admin_run prepare-prune 0 "$ids_file" auto || return 1

  daemon_snapshot
  local daemon_was_running=0
  [[ "$DAEMON_STATE" == "running" ]] && daemon_was_running=1

  if ! daemon_stop_for_prune; then
    warn "unable to stop Codex background runtime safely; prune aborted before program removal"
    return 1
  fi

  if ! session_admin_run delete-ids 0 "$ids_file" stdio; then
    warn "background thread interruption succeeded, but persistent thread deletion was incomplete."
    if (( daemon_was_running )); then
      daemon_snapshot
      DAEMON_WAS_RUNNING=1
      daemon_restore_after_mutation || true
    fi
    return 1
  fi

  foreground="$(foreground_codex_pids)"
  if [[ -n "$foreground" ]]; then
    warn "Codex process(es) appeared while prune was running:"
    printf '%s\n' "$foreground" >&2
    if (( daemon_was_running )); then
      daemon_snapshot
      DAEMON_WAS_RUNNING=1
      daemon_restore_after_mutation || true
    fi
    return 1
  fi

  if [[ -L "$CODEX_COMMAND" || ( -f "$CODEX_COMMAND" && "$force" == "1" ) ]]; then
    rm -f -- "$CODEX_COMMAND"
  fi
  rm -f -- "$CURRENT_LINK"
  rm -rf -- "$VERSIONS_DIR" "$DOWNLOADS_DIR"
  mkdir -p -- "$VERSIONS_DIR" "$DOWNLOADS_DIR"

  rm -rf -- \
    "$CODEX_DATA_DIR/packages/app-server-daemon" \
    "$CODEX_DATA_DIR/packages/standalone" \
    "$CODEX_DATA_DIR/app-server-daemon" \
    "$CODEX_DATA_DIR/app-server-control"

  log "pruned Codex program/runtime assets and all loaded/background thread records"
  log "inactive saved session history, configuration, authentication, skills, rules, and other user state were preserved"
}

daemon_protected_socket_path() {
  local advertised="$CODEX_DATA_DIR/app-server-control/app-server-control.sock"
  local parent
  parent="$(dirname "$advertised")"
  mkdir -p -- "$parent"
  chmod 0700 -- "$parent" 2>/dev/null || true
  python3 - "$parent" "$(basename "$advertised")" <<'PY'
import hashlib, os, sys
parent=os.path.realpath(sys.argv[1])
path=os.path.join(parent, sys.argv[2])
root=os.path.realpath("/tmp")
print(os.path.join(root, f"codex-daemon-{os.geteuid()}", hashlib.sha256(os.fsencode(path)).hexdigest()))
PY
}

unix_socket_connectable() {
  local path="$1"
  python3 - "$path" <<'PY' >/dev/null 2>&1
import socket, sys
s=socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(0.25)
try:
    s.connect(sys.argv[1])
except OSError:
    raise SystemExit(1)
else:
    raise SystemExit(0)
finally:
    s.close()
PY
}

daemon_terminate_managed_processes() {
  local pids pid deadline remaining
  pids="$(daemon_managed_pids)"
  [[ -n "$pids" ]] || return 0

  warn "terminating stale managed Codex app-server process(es): $(tr '\n' ' ' <<<"$pids" | sed 's/[[:space:]]\+/ /g')"
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    kill -TERM "$pid" 2>/dev/null || true
  done <<<"$pids"

  deadline=$((SECONDS + 5))
  while (( SECONDS < deadline )); do
    remaining="$(daemon_managed_pids)"
    [[ -z "$remaining" ]] && return 0
    sleep 1
  done

  remaining="$(daemon_managed_pids)"
  if [[ -n "$remaining" ]]; then
    warn "forcing termination of stale managed Codex app-server process(es): $(tr '\n' ' ' <<<"$remaining" | sed 's/[[:space:]]\+/ /g')"
    while IFS= read -r pid; do
      [[ -n "$pid" ]] || continue
      kill -KILL "$pid" 2>/dev/null || true
    done <<<"$remaining"
    sleep 1
  fi

  remaining="$(daemon_managed_pids)"
  [[ -z "$remaining" ]] || { warn "managed app-server processes are still running: $remaining"; return 1; }
}

daemon_cleanup_transient_state() {
  local state="$CODEX_DATA_DIR/app-server-daemon"
  local control="$CODEX_DATA_DIR/app-server-control"
  local advertised="$control/app-server-control.sock"
  local physical shared owner mode

  physical="$(daemon_protected_socket_path)"
  if [[ -e "$physical" || -S "$physical" || -L "$physical" ]]; then
    if unix_socket_connectable "$physical"; then
      warn "refusing to remove active physical daemon socket: $physical"
      return 1
    fi
    shared="$(dirname "$physical")"
    if [[ -d "$shared" ]]; then
      owner="$(stat -c '%u' "$shared" 2>/dev/null || true)"
      mode="$(stat -c '%a' "$shared" 2>/dev/null || true)"
      [[ "$owner" == "$UID" && "$mode" == "700" ]] || {
        warn "refusing to modify unsafe daemon socket directory: $shared (owner=$owner mode=$mode)"
        return 1
      }
    fi
    rm -f -- "$physical" "$physical.lock"
  fi

  if [[ -e "$advertised" || -S "$advertised" || -L "$advertised" ]]; then
    if unix_socket_connectable "$advertised"; then
      warn "refusing to remove active advertised daemon socket: $advertised"
      return 1
    fi
    rm -f -- "$advertised"
  fi
  rm -f -- "$control/app-server-startup.lock"

  local name
  for name in app-server.pid app-server-updater.pid daemon.pid daemon-updater.pid; do
    rm -f -- "$state/$name"
  done

  # Preserve settings.json, logs, loaded-threads.json and managed packages.
  return 0
}

daemon_status() {
  daemon_snapshot
  printf 'Daemon support: %s\n' "$([[ "$DAEMON_SUPPORTED" == "1" ]] && printf yes || printf no)"
  printf 'Daemon state:   %s\n' "$DAEMON_STATE"
  [[ -z "$DAEMON_BIN" ]] || printf 'Control binary: %s\n' "$DAEMON_BIN"
  [[ -z "$DAEMON_BACKEND" ]] || printf 'Backend:        %s\n' "$DAEMON_BACKEND"

  if [[ -s "$DAEMON_LAST_JSON" ]]; then
    local managed_path managed_version app_version socket_path
    managed_path="$(daemon_json_field "$DAEMON_LAST_JSON" managedCodexPath)"
    managed_version="$(daemon_json_field "$DAEMON_LAST_JSON" managedCodexVersion)"
    app_version="$(daemon_json_field "$DAEMON_LAST_JSON" appServerVersion)"
    socket_path="$(daemon_json_field "$DAEMON_LAST_JSON" socketPath)"
    [[ -z "$managed_path" ]] || printf 'Managed binary: %s\n' "$managed_path"
    [[ -z "$managed_version" ]] || printf 'Managed version:%s%s\n' " " "$managed_version"
    [[ -z "$app_version" ]] || printf 'Running version:%s%s\n' " " "$app_version"
    [[ -z "$socket_path" ]] || printf 'Control socket: %s\n' "$socket_path"
  fi

  local pids
  pids="$(daemon_managed_pids)"
  [[ -z "$pids" ]] || printf 'Managed PIDs:   %s\n' "$(tr '\n' ' ' <<<"$pids" | sed 's/[[:space:]]\+/ /g')"
  if [[ "$DAEMON_STATE" == "stale" || "$DAEMON_STATE" == "unknown" ]]; then
    [[ ! -s "$DAEMON_LAST_ERR" ]] || printf 'Last error:     %s\n' "$(tr '\n' ' ' < "$DAEMON_LAST_ERR" | sed 's/[[:space:]]\+/ /g' | cut -c1-500)"
  fi
}

daemon_repair() {
  local yes="$1"
  daemon_snapshot
  case "$DAEMON_STATE" in
    running)
      log "managed Codex app-server daemon is healthy; no repair is required"
      return 0
      ;;
    unmanaged-running)
      die "an unmanaged app-server is running; codex-tool will not terminate or repair it"
      ;;
    stopped)
      log "managed Codex app-server daemon is stopped and reports healthy lifecycle state; no repair is required"
      return 0
      ;;
    unsupported)
      die "no daemon-capable Codex CLI is available"
      ;;
  esac

  confirm_or_die "$yes" "Repair stale Codex app-server daemon state? This may terminate stale managed app-server processes."

  local should_restart=0
  if daemon_has_processes || daemon_pid_records_present || \
     [[ -e "$CODEX_DATA_DIR/app-server-control/app-server-control.sock" || -L "$CODEX_DATA_DIR/app-server-control/app-server-control.sock" ]]; then
    should_restart=1
  fi

  local binary
  binary="$(daemon_find_control_binary 2>/dev/null || true)"
  [[ -n "$binary" ]] || die "no daemon-capable Codex binary is available for repair"

  make_work_dir
  local out="$WORK_DIR/daemon-repair-stop.$$.json" err="$WORK_DIR/daemon-repair-stop.$$.stderr"
  if daemon_lifecycle "$binary" stop "$out" "$err"; then
    log "official daemon stop completed during repair"
  else
    warn "official daemon stop failed; continuing with conservative stale-process recovery"
    [[ ! -s "$err" ]] || warn "daemon stop: $(tr '\n' ' ' < "$err" | sed 's/[[:space:]]\+/ /g' | cut -c1-500)"
  fi

  daemon_terminate_managed_processes || die "unable to terminate stale managed app-server processes"
  daemon_cleanup_transient_state || die "unable to clean stale daemon runtime state safely"

  if (( should_restart )); then
    binary="$(daemon_find_control_binary 2>/dev/null || true)"
    [[ -n "$binary" ]] || die "transient daemon state was cleaned, but no daemon-capable binary is available to restart it"
    out="$WORK_DIR/daemon-repair-start.$$.json"
    err="$WORK_DIR/daemon-repair-start.$$.stderr"
    if ! daemon_lifecycle "$binary" start "$out" "$err"; then
      [[ ! -s "$err" ]] || warn "daemon start: $(tr '\n' ' ' < "$err" | sed 's/[[:space:]]\+/ /g' | cut -c1-500)"
      die "daemon runtime state was cleaned but app-server could not be restarted"
    fi
    local status
    status="$(daemon_json_field "$out" status)"
    case "$status" in
      started|alreadyRunning|running|restarted)
        log "managed Codex app-server daemon repaired and running"
        ;;
      *)
        die "daemon restart after repair returned unexpected status: ${status:-unknown}"
        ;;
    esac
  else
    log "stale daemon runtime state cleaned; daemon remains stopped"
  fi
}

auth_login() {
  [[ -t 0 && -t 2 ]] || die "auth login requires an interactive terminal"
  make_work_dir
  local out="$WORK_DIR/auth-login.json"
  print_github_token_help
  printf '\nPaste GitHub token (input hidden): ' >&2
  local token=""
  IFS= read -r -s token
  printf '\n' >&2
  [[ -n "$token" ]] || die "empty token"
  validate_github_token_text "$token" || die "token contains whitespace"

  local body="$WORK_DIR/auth-login-body.json"
  local headers="$WORK_DIR/auth-login.headers"
  local err="$WORK_DIR/auth-login.stderr"
  local result rc status msg
  result="$(github_api_once "$API_BASE/releases/latest" "$body" "$headers" "$err" normal "$token")"
  rc="$(sed -n '1p' <<<"$result")"
  status="$(sed -n '2p' <<<"$result")"
  if [[ "$rc" == "0" && "$status" =~ ^2[0-9][0-9]$ ]]; then
    save_github_token "$token"
    log "GitHub authentication verified against openai/codex release API"
    return 0
  fi
  msg="$(github_error_message "$body")"
  [[ -n "$msg" ]] && warn "GitHub: $msg"
  [[ -s "$err" ]] && warn "curl: $(tr '\n' ' ' < "$err" | sed 's/[[:space:]]\+/ /g' | cut -c1-500)"
  die "GitHub token verification failed (curl exit $rc, HTTP $status); token was not saved"
}

auth_status() {
  printf 'GitHub auth source: %s' "$(github_token_source)"
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    printf ' (environment token takes precedence over saved token)\n'
  else
    printf '\n'
  fi
}

auth_logout() {
  if [[ -f "$GITHUB_TOKEN_FILE" || -L "$GITHUB_TOKEN_FILE" ]]; then
    rm -f -- "$GITHUB_TOKEN_FILE"
    log "removed saved GitHub token: $GITHUB_TOKEN_FILE"
  else
    log "no codex-tool saved GitHub token found"
  fi
  [[ -z "${GITHUB_TOKEN:-}" ]] || warn "GITHUB_TOKEN is still set in the current environment and will continue to take precedence."
}

init_install_mutation() {
  ensure_supported_platform
  need_cmd curl
  need_cmd python3
  need_cmd tar
  need_cmd sha256sum
  need_cmd find
  need_cmd sort
  need_cmd stat
  init_curl_compat
  validate_uint CODEX_TOOL_API_TIMEOUT "$API_TIMEOUT"
  validate_uint CODEX_TOOL_CONNECT_TIMEOUT "$CONNECT_TIMEOUT"
  validate_uint CODEX_TOOL_DOWNLOAD_RETRIES "$DOWNLOAD_RETRIES"
  validate_uint CODEX_TOOL_DOWNLOAD_RETRY_DELAY "$DOWNLOAD_RETRY_DELAY"
  validate_uint CODEX_TOOL_DOWNLOAD_STALL_TIME "$DOWNLOAD_STALL_TIME"
  validate_uint CODEX_TOOL_DOWNLOAD_MAX_TIME "$DOWNLOAD_MAX_TIME"
  ensure_layout
  lock_manager
  ensure_command_links
}

init_manager_mutation() {
  ensure_supported_platform
  need_cmd python3
  need_cmd find
  need_cmd sort
  need_cmd stat
  ensure_layout
  lock_manager
  ensure_command_links
}

init_github_auth() {
  need_cmd curl
  need_cmd python3
  init_curl_compat
  validate_uint CODEX_TOOL_API_TIMEOUT "$API_TIMEOUT"
  validate_uint CODEX_TOOL_CONNECT_TIMEOUT "$CONNECT_TIMEOUT"
}

main() {
  local cmd="${1:-help}"

  # Fast read-only paths deliberately avoid manager layout creation, link repair,
  # network dependency checks, and the exclusive manager lock.
  case "$cmd" in
    version|--version|-V)
      [[ $# -eq 1 ]] || die "usage: codex-tool version"
      printf 'codex-tool %s\n' "$TOOL_VERSION"
      return 0
      ;;
    help|-h|--help)
      [[ $# -eq 1 ]] || die "usage: codex-tool help"
      usage
      return 0
      ;;
    list)
      [[ $# -eq 1 ]] || die "usage: codex-tool list"
      ensure_supported_platform
      need_cmd find
      need_cmd sort
      list_versions
      return 0
      ;;
  esac

  case "$cmd" in
    install)
      [[ $# -eq 2 ]] || die "usage: codex-tool install X.Y.Z"
      init_install_mutation
      install_version "$2"
      ;;
    update)
      [[ $# -eq 1 ]] || die "usage: codex-tool update"
      init_install_mutation
      local latest
      latest="$(latest_stable_version)"
      log "latest stable Codex version: $latest"
      install_version "$latest"
      ;;
    delete)
      [[ $# -eq 2 ]] || die "usage: codex-tool delete X.Y.Z"
      init_manager_mutation
      delete_version "$2"
      ;;
    switch)
      [[ $# -eq 2 ]] || die "usage: codex-tool switch X.Y.Z"
      init_manager_mutation
      switch_version "$2"
      ;;
    clean)
      init_manager_mutation
      local yes=0 all_threads=0 dry_run=0
      shift
      while (($#)); do
        case "$1" in
          --yes|-y) yes=1 ;;
          --all) all_threads=1 ;;
          --dry-run) dry_run=1 ;;
          *) die "unknown clean option: $1" ;;
        esac
        shift
      done
      clean_data "$yes" "$all_threads" "$dry_run"
      ;;
    prune)
      init_manager_mutation
      local yes=0 force=0 dry_run=0
      shift
      while (($#)); do
        case "$1" in
          --yes|-y) yes=1 ;;
          --force) force=1 ;;
          --dry-run) dry_run=1 ;;
          *) die "unknown prune option: $1" ;;
        esac
        shift
      done
      prune_all "$yes" "$force" "$dry_run"
      ;;
    daemon)
      [[ $# -ge 2 ]] || die "usage: codex-tool daemon {status|repair [--yes]}"
      case "$2" in
        status)
          [[ $# -eq 2 ]] || die "usage: codex-tool daemon status"
          ensure_supported_platform
          need_cmd python3
          need_cmd stat
          daemon_status
          ;;
        repair)
          init_manager_mutation
          local yes=0
          shift 2
          while (($#)); do
            case "$1" in
              --yes|-y) yes=1 ;;
              *) die "unknown daemon repair option: $1" ;;
            esac
            shift
          done
          daemon_repair "$yes"
          ;;
        *)
          die "usage: codex-tool daemon {status|repair [--yes]}"
          ;;
      esac
      ;;
    auth)
      [[ $# -eq 2 ]] || die "usage: codex-tool auth {login|status|logout}"
      case "$2" in
        login)
          init_github_auth
          auth_login
          ;;
        status)
          auth_status
          ;;
        logout)
          auth_logout
          ;;
        *)
          die "usage: codex-tool auth {login|status|logout}"
          ;;
      esac
      ;;
    *)
      die "unknown command: $cmd (run 'codex-tool help')"
      ;;
  esac
}

main "$@"
